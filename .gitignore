### Additional file types to ignore
# Lightmaps
*.exr

# SpeedTree
*.spm

# Other binaries that should not be tracked
*.obj
*.pdb

### Git LFS note:
# Make sure to track large binary assets via:
git lfs track "*.psd"
git lfs track "*.png"
git lfs track "*.jpg"
git lfs track "*.fbx"
git lfs track "*.wav"
git lfs track "*.mp4"
